# Copy to .env (local runs) or enter these as the host's environment variables. NEVER commit real values.
DISCORD_TOKEN=paste-the-bot-token-from-the-discord-developer-portal
ANTHROPIC_API_KEY=paste-the-key-from-console.anthropic.com

# shadow = the bot only REPORTS what it would do (to #mod-queue); active = it deletes / times out on its own.
# Run shadow for the first week, read its calls, then switch.
MOD_MODE=shadow

# The monthly API budget the bot paces itself to (the hard cap is the spend limit in the Anthropic console).
MONTHLY_BUDGET_USD=10

# Members who joined less than this many days ago have every message checked; older members only when flagged.
NEW_MEMBER_DAYS=7

# Channel names (without #).
ASK_CHANNEL=ask
MOD_QUEUE_CHANNEL=mod-queue
MOD_LOG_CHANNEL=mod-log

# Anyone reacting with this emoji sends the message to the mod queue with the bot's read of it.
FLAG_EMOJI=🚩

# Automatic timeouts are short and undo themselves. Capped at 60 in code.
TIMEOUT_MINUTES=10

# Seconds a member waits between questions to the bot.
ASK_COOLDOWN_SECONDS=60

# --- Posting (posts.py) ---------------------------------------------------------------------------------------------
# Where drafts wait for approval (staff-only channel), and where each kind of post goes.
DRAFTS_CHANNEL=mod-queue
ANNOUNCE_CHANNEL=announcements
DEVLOG_CHANNEL=devlog
RULES_CHANNEL=welcome-and-rules
ROLES_CHANNEL=roles

# The opt-in role each kind of post pings (empty = no ping). Never @everyone.
ANNOUNCE_PING_ROLE=Announcements
DEVLOG_PING_ROLE=Devlog

# The colour bar on Spirekeeper's posts (hex, no #). Match it to the logo once there is one.
BRAND_COLOR=6C5CE7

# Welcome message on join (text: knowledge/welcome.md). Needs "Server Members Intent" switched on in the Developer
# Portal (Bot tab) FIRST - with this on and that off, Discord refuses the bot's login.
WELCOME_ON_JOIN=0
WELCOME_CHANNEL=general
